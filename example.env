NODE_ENV=development

APP_HOST=127.0.0.1
APP_PORT=3400
API_PREFIX=api

CORS_ORIGINS=http://localhost:3400
ENABLE_CSRF=true

CSRF_COOKIE_NAME=csrf_token
COOKIE_SECRET=change-me-cookie-secret
CSRF_SECRET=change-me-csrf-secret

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
JWT_VERIFY_EMAIL_SECRET=change-me-verify-email-secret
JWT_VERIFY_EMAIL_EXPIRES_IN=1h
PASSWORD_RESET_TOKEN_EXPIRES_MIN=15

RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# เปิด Swagger docs (ตั้งเป็น false ได้ใน production หากไม่ต้องการเปิด)
ENABLE_SWAGGER=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=db_name
